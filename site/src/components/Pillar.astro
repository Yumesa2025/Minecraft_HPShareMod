---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { href } from '../lib/url';

interface Props {
  index: string;
  eyebrow: string;
  title: string;
  /** src/assets 에서 import 한 그림. 넘기면 글 반대편에 놓인다. */
  image?: ImageMetadata;
  /** 그림을 못 보는 사람에게 읽어 줄 말. image 를 넘기면 함께 넘긴다. */
  alt?: string;
  /** site/public/media/ 안의 파일 이름. 그림 대신 쓸 수 있다. */
  video?: string;
  flip?: boolean;
}

const { index, eyebrow, title, image, alt = '', video, flip = false } = Astro.props;
const hasMedia = Boolean(image || video);
---
<section class:list={['pillar', { flip, solo: !hasMedia }]}>
  <div class="text">
    <p class="eyebrow">{index} {eyebrow}</p>
    <h2>{title}</h2>
    <slot />
  </div>
  {hasMedia && (
    <div class="media">
      {image && <Image src={image} alt={alt} widths={[480, 960]} sizes="(min-width: 721px) 480px, 100vw" />}
      {!image && video && (
        <video src={href(`/media/${video}`)} autoplay muted loop playsinline preload="metadata"></video>
      )}
    </div>
  )}
</section>

<style>
  .pillar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
    align-items: center;
    border-top: 1px solid var(--border);
    padding: 2rem 0;
  }
  .pillar.flip .text { order: 2; }
  .pillar.solo { grid-template-columns: 1fr; }
  .pillar.solo .text { max-width: var(--measure); }
  /* 영상이 없으면 칸이 하나라 order 가 안 먹는다. 글 자체를 오른쪽으로 붙인다. */
  .pillar.solo.flip .text { margin-left: auto; }

  .eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  h2 { margin: 0.3rem 0 0.6rem; }
  .text :global(p) { color: var(--muted); margin: 0.5rem 0 0; }

  video {
    width: 100%;
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
  }

  /*
   * 높이를 묶어 둔다. 화면 전체를 찍은 그림은 옆으로 길어 이 한계에 안 닿지만,
   * HUD 한 조각처럼 정사각형에 가까운 그림은 그냥 두면 글보다 커져 절을 삼킨다.
   */
  .media :global(img) {
    max-width: 100%;
    max-height: 18rem;
    width: auto;
    height: auto;
    display: block;
    margin-inline: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
  }

  @media (max-width: 720px) {
    .pillar, .pillar.flip { grid-template-columns: 1fr; }
    .pillar.flip .text { order: 0; }
    /* 좁은 화면에서는 좌우로 나눌 자리가 없다. 전부 왼쪽에 붙인다. */
    .pillar.solo.flip .text { margin-left: 0; }
  }
</style>
