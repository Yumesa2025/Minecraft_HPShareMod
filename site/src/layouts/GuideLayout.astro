---
import Base from './Base.astro';
import GuideTabs from '../components/GuideTabs.astro';

const { frontmatter } = Astro.props;
const { title, tab, description } = frontmatter;
---
<Base title={`${title} — SharedFate 가이드`} description={description}>
  <GuideTabs current={tab} />
  <div class="wrap body">
    <article class="prose">
      <h1>{title}</h1>
      <slot />
    </article>
  </div>
</Base>

<style>
  .body { padding-top: 1.4rem; }
</style>
